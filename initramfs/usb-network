#!/bin/sh
# Native initramfs only: one ECM peer, memory-backed logs, no block storage.
set -eu
[ "${I14_DEBUG_INITRAMFS:-0}" = 1 ] || exit 0
g=/sys/kernel/config/usb_gadget/i14
bound=0
ready=0
http_pid=
dhcp_pid=
telnet_pid=
serial_pid=
log() {
    printf '%s\n' "$*"
    printf '<6>%s\n' "$*" >/dev/kmsg 2>/dev/null || :
}
service_failure() {
    if wait "$2"; then service_status=0; else service_status=$?; fi
    log "I14_SERVICE_EXIT: $1 status=$service_status"
    while IFS= read -r service_line; do
        log "I14_SERVICE_LOG: $1 $service_line"
    done <"$3"
}
log I14_USB_SETUP_BEGIN
for controller in /sys/class/udc/*; do
    [ -d "$controller" ] || continue
    log "I14_UDC ${controller##*/} driver=$(readlink "$controller/device/driver" || :)"
    for attribute in state function current_speed maximum_speed; do
        [ ! -r "$controller/$attribute" ] || log "I14_UDC $attribute=$(cat "$controller/$attribute")"
    done
done
cleanup() {
    status=$?
    if [ "$ready" -eq 0 ]; then
        log "I14_USB_SETUP_ERROR: status=$status; console remains available"
        [ -z "$http_pid" ] || kill "$http_pid" 2>/dev/null || :
        [ -z "$dhcp_pid" ] || kill "$dhcp_pid" 2>/dev/null || :
        [ -z "$telnet_pid" ] || kill "$telnet_pid" 2>/dev/null || :
        if [ -n "$serial_pid" ]; then
            kill "$serial_pid" 2>/dev/null || :
            wait "$serial_pid" 2>/dev/null || :
        fi
        [ "$bound" -eq 0 ] || printf '\n' >"$g/UDC"
    fi
}
trap cleanup EXIT

attempt=0
while :; do
    count=0
    udc=
    for candidate in /sys/class/udc/*; do
        [ -d "$candidate" ] || continue
        count=$((count + 1))
        udc=${candidate##*/}
    done
    [ "$count" -le 1 ] || { echo 'ERROR: multiple UDCs; refusing to choose'; exit 1; }
    [ "$count" -eq 0 ] || break
    attempt=$((attempt + 1))
    [ "$attempt" -lt 10 ] || { echo 'ERROR: no UDC after 10 probes'; exit 1; }
    sleep 1
done

if [ ! -d /sys/kernel/config/usb_gadget ]; then
    mount -t configfs configfs /sys/kernel/config
fi
[ -d /sys/kernel/config/usb_gadget ] || { echo 'ERROR: USB configfs unavailable'; exit 1; }
[ ! -e "$g" ] || { echo 'ERROR: existing I14 gadget; inspect before retry'; exit 1; }
mkdir "$g"
printf '0x1d6b\n' >"$g/idVendor"
printf '0x0104\n' >"$g/idProduct"
# Match the COMM device class of the previously host-recognized g_cdc gadget.
printf '0x02\n' >"$g/bDeviceClass"
mkdir -p "$g/strings/0x409" "$g/configs/c.1/strings/0x409" "$g/functions/ecm.usb0"
printf '0xc0\n' >"$g/configs/c.1/bmAttributes"
printf '500\n' >"$g/configs/c.1/MaxPower"
printf 'I14_NATIVE_INIT\n' >"$g/strings/0x409/serialnumber"
printf 'I14 Linux\n' >"$g/strings/0x409/manufacturer"
printf 'I14 Linux Bringup\n' >"$g/strings/0x409/product"
printf 'ECM direct debug link\n' >"$g/configs/c.1/strings/0x409/configuration"
printf '02:14:00:00:00:02\n' >"$g/functions/ecm.usb0/dev_addr"
printf '02:14:00:00:00:01\n' >"$g/functions/ecm.usb0/host_addr"
ln -s "$g/functions/ecm.usb0" "$g/configs/c.1/ecm.usb0"
mkdir "$g/functions/acm.usb0"
ln -s "$g/functions/acm.usb0" "$g/configs/c.1/acm.usb0"
printf '%s\n' "$udc" >"$g/UDC"
bound=1
iface=$(cat "$g/functions/ecm.usb0/ifname")
case "$iface" in ''|*[!a-zA-Z0-9_.-]*) echo 'ERROR: invalid ECM interface name'; exit 1 ;; esac
[ -d "/sys/class/net/$iface" ] || { echo 'ERROR: ECM interface missing'; exit 1; }
[ "$(cat "/sys/class/net/$iface/address")" = '02:14:00:00:00:02' ] || {
    echo 'ERROR: ECM interface MAC mismatch'; exit 1;
}
[ ! -e /proc/sys/net/ipv4/ip_forward ] || printf '0\n' >/proc/sys/net/ipv4/ip_forward
ip addr add 10.77.14.2/30 dev "$iface"
ip link set dev "$iface" up
printf '%s\n' "$iface" >/run/usb-interface
(
    set +m
    serial_child=
    stop_serial() {
        if [ -n "$serial_child" ]; then
            # Interactive shells can ignore TERM; stop only our tracked child.
            kill -KILL "$serial_child" 2>/dev/null || :
            wait "$serial_child" 2>/dev/null || :
        fi
        log I14_SERIAL_STOPPED
        exit 0
    }
    trap stop_serial TERM INT
    log I14_SERIAL_WAIT_BEGIN
    serial_attempt=0
    while [ ! -c /dev/ttyGS0 ]; do
        serial_attempt=$((serial_attempt + 1))
        [ "$serial_attempt" -lt 10 ] || { log I14_SERIAL_TTY_TIMEOUT; exit 0; }
        sleep 1
    done
    log I14_SERIAL_TTY_READY
    while :; do
        log I14_SERIAL_SHELL_START
        # The new session leader opens its own tty; cttyhack would select UART.
        setsid sh -c 'exec sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1' &
        serial_child=$!
        if wait "$serial_child"; then serial_status=0; else serial_status=$?; fi
        serial_child=
        log "I14_SERIAL_SHELL_EXIT status=$serial_status"
        sleep 1
    done
) >/run/serial-console.log 2>&1 &
serial_pid=$!
printf '%s\n' "$serial_pid" >/run/i14-serial-console.pid
mkdir -p /run/www
{
    printf '<!doctype html><title>I14 Linux Bringup</title><pre>\nI14_NATIVE_INIT\n'
    uname -a
    printf 'USB ECM: 10.77.14.2/30; peer 10.77.14.1\n</pre>\n'
} >/run/www/index.html
dmesg >/run/www/dmesg.txt || echo 'dmesg unavailable' >/run/www/dmesg.txt
httpd -f -p 10.77.14.2:8080 -h /run/www >/run/httpd.log 2>&1 &
http_pid=$!
printf '%s\n' "$http_pid" >/run/i14-httpd.pid
sleep 1
kill -0 "$http_pid" || {
    log 'ERROR: HTTP startup failed'
    service_failure httpd "$http_pid" /run/httpd.log
    exit 1
}
telnetd -F -b 10.77.14.2:23 -l /bin/sh >/run/telnetd.log 2>&1 &
telnet_pid=$!
printf '%s\n' "$telnet_pid" >/run/i14-telnetd.pid
sleep 1
kill -0 "$telnet_pid" || {
    log 'ERROR: telnet startup failed'
    service_failure telnetd "$telnet_pid" /run/telnetd.log
    exit 1
}
cat >/run/udhcpd.conf <<EOF
start 10.77.14.1
end 10.77.14.1
interface $iface
max_leases 1
lease_file /run/udhcpd.leases
pidfile /run/i14-udhcpd.pid
auto_time 0
opt subnet 255.255.255.252
opt lease 600
EOF
udhcpd -f /run/udhcpd.conf >/run/udhcpd.log 2>&1 &
dhcp_pid=$!
printf '%s\n' "$dhcp_pid" >/run/i14-udhcpd.pid
sleep 1
if ! kill -0 "$dhcp_pid" 2>/dev/null; then
    service_failure udhcpd "$dhcp_pid" /run/udhcpd.log
    log 'WARNING: DHCP unavailable; set USB peer manually to 10.77.14.1/30; see /run/udhcpd.log'
fi
ready=1
log "I14_USB_ECM_READY: $iface via $udc; http://10.77.14.2:8080/ telnet=10.77.14.2:23"
(
    sleep 10
    log "I14_USB_DELAYED_SNAPSHOT udc=$udc iface=$iface"
    for attribute in state function current_speed maximum_speed; do
        [ ! -r "/sys/class/udc/$udc/$attribute" ] || log "I14_UDC $attribute=$(cat "/sys/class/udc/$udc/$attribute")"
    done
    for attribute in operstate carrier mtu; do
        [ ! -r "/sys/class/net/$iface/$attribute" ] || log "I14_USB_NET $attribute=$(cat "/sys/class/net/$iface/$attribute")"
    done
    for service in httpd telnetd udhcpd; do
        pid=$(cat "/run/i14-$service.pid")
        if kill -0 "$pid" 2>/dev/null; then state=alive; else state=exited; fi
        log "I14_USB_SERVICE $service $state pid=$pid"
    done
    ip addr show dev "$iface" 2>&1 | while IFS= read -r line; do log "I14_USB_ADDR $line"; done
) >/run/usb-snapshot.log 2>&1 &
printf '%s\n' "$!" >/run/i14-usb-snapshot.pid
