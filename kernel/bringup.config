# Overlay on the pinned Nura MT6735 config; board wiring belongs in the I14 DTS.
CONFIG_LOCALVERSION="-i14-bringup"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_RD_LZMA=y
CONFIG_RD_ZSTD=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_CONFIGFS_FS=y
CONFIG_ARCH_MEDIATEK=y
CONFIG_PINCTRL_MT6735=y
CONFIG_COMMON_CLK_MT6735=y
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MFD_MT6397=y
CONFIG_REGULATOR_MT6328=y
CONFIG_MTK_SCPSYS=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_GADGET=y
# CONFIG_USB_MUSB_HOST is not set
# CONFIG_USB_MUSB_DUAL_ROLE is not set
CONFIG_USB_MUSB_MEDIATEK=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
# Keep the UDC available for /init's configfs gadget.
# CONFIG_USB_CDC_COMPOSITE is not set
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_LOG_BUF_SHIFT=20
CONFIG_CMDLINE=""
# CONFIG_CMDLINE_FORCE is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_DEBUG_INFO_BTF_MODULES is not set
